+impl ScopedInterval {
+    fn advance(self, before: Interval, after: Interval) -> Option<Self> {
+        Some(Self {
+            calls: self
+                .calls
+                .checked_add(after.calls.checked_sub(before.calls)?)?,
+            failures: self
+                .failures

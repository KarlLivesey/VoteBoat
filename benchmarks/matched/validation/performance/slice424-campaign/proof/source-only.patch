+        assert!(cluster.actors.iter().all(|actor| !actor.is_finished()));
+        assert!(crate::guard::finish(Ok(()), cleanup).is_err());
+        drop(cluster);
+        crate::guard::bounded("release observation", Duration::from_secs(1), async {
+            for released in releases {
+                released.await?;
+            }
+            Ok(())
+        })
+        .await
+        .unwrap();
+    }

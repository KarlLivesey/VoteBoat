+                    let core = n.local().owner.core(group(g)).unwrap();
+                    let s = core.state();
+                    let index = s.entries.iter().find_map(|e| match e.payload {
+                        EntryPayload::Command { operation: id, .. } if id == ticket.operation => {
+                            Some(e.index)
+                        }
+                        _ => None,
+                    });
+                    let app = &n.local().applications[&group(g)];
+                    eprintln!(
+                        "node {:?} {:?} term {:?} op {index:?} commit {:?} applied {:?} done {}",
+                        core.local_node(),
+                        core.role(),
+                        s.hard_state.term,
+                        s.commit_index,
+                        app.applied_index(),
+                        done(app)
+                    );
+                }
+            }
+        }

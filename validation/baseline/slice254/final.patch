+        .unwrap_err();
+    assert!(matches!(
+        refusal.reason,
+        ClientError::Consensus(voteboat::raft::RaftError::NotLeader)
+    ));
+    assert_eq!(refusal.request.group, group(1));
+    assert_eq!(refusal.request.operation, operation);
+    assert_eq!(refusal.request.bytes, bytes);

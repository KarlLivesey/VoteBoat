+fn release_uncertain<A>(
+    nodes: &mut [Node<A>],
+    clock: &Instant,
+    completion: ClientCompletion<A::Receipt>,
+) where
+    A: ProposalAdmission + BoundedReadableStateMachine + CheckpointStateMachine,

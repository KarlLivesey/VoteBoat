new file mode 100644
index 0000000..15c02ee
--- /dev/null
+++ b/tests/quic/peer_close.rs
@@ -0,0 +1,61 @@
+// SPDX-License-Identifier: RPL-1.5
+// Copyright (c) 2026 Karl Livesey
+use super::*;
+
+#[test]
+fn clean_peer_close_at_last_io_call_retains_response_and_protocol_timer() {
+    let ((mut a, mut b), arrivals) =
+        configured_pair_with(1, 1, SessionLimits::default(), Arrivals::capture);
+    let start = arrivals.ready(&mut a, &mut b);
+    a.close();
+    let budget = SessionPollBudget {
+        io_calls: 1,
+        read_bytes: 1200,
+        write_bytes: 1200,
+    };
+    let mut received_at = None;
+    for time in start..start + 100 {
+        let progress = a.poll(MonoTime(time), budget).unwrap();
+        arrivals.emitted(0, progress.written_bytes);
+        let progress = b.poll(MonoTime(time), budget).unwrap();
+        arrivals.emitted(1, progress.written_bytes);
+        if b.state() != SessionState::Ready {
+            assert!(progress.read_bytes > 0);
+            assert_eq!(progress.written_bytes, 0);
+            received_at = Some(time);
+            break;
+        }
+    }
+    let received_at = received_at.expect("actual authenticated peer close must arrive");
+    let status = b.drain_status();
+    // EOF denies fresh writes; it does not remove the original protocol owner
+    // before that owner can send its queued close response with a fresh budget.
+    assert_eq!(b.read_plaintext(&mut [0; 1]), Ok(0));
+    assert_eq!(
+        b.write_plaintext(b"after peer close"),
+        Err(SessionError::Closed)
+    );
+    let mut response = false;
+    for time in received_at + 1..received_at + 100 {
+        let progress = b.poll(MonoTime(time), budget).unwrap();
+        assert!(progress.io_calls <= 1);
+        assert!(progress.read_bytes <= 1200 && progress.written_bytes <= 1200);
+        arrivals.emitted(1, progress.written_bytes);
+        response |= progress.written_bytes > 0;
+        let progress = a.poll(MonoTime(time), budget).unwrap();
+        arrivals.emitted(0, progress.written_bytes);
+        if response {
+            break;
+        }
+    }
+    assert!(response, "clean EOF must not strand Quinn's close response");
+    assert_eq!(status.state, SessionState::Closing, "{status:?}");
+    assert_eq!(status.protocol_drained, Some(false));
+    assert!(status.next_deadline.is_some());
+    assert_eq!(b.state(), SessionState::Closing);
+    let deadline = b.drain_status().next_deadline.unwrap();
+    b.poll(deadline, budget).unwrap();
+    assert_eq!(b.state(), SessionState::Closed);
+    assert_eq!(b.drain_status().protocol_drained, Some(true));
+    assert_eq!(b.next_deadline(), None);
+}
diff --git a/tests/raft/reference/host/persistence.rs b/tests/raft/reference/host/persistence.rs
new file mode 100644
index 0000000..96125f5
--- /dev/null
+++ b/tests/raft/reference/host/persistence.rs
@@ -0,0 +1,187 @@
+// SPDX-License-Identifier: RPL-1.5
+// Copyright (c) 2026 Karl Livesey
+use super::*;
+use raft_reference::eraftpb::HardState as ReferenceHardState;
+
+#[derive(Clone, Default)]
+struct Image {
+    entries: Vec<Entry>,
+    hard: ReferenceHardState,
+}
+#[derive(Default)]
+pub(super) struct Disk {
+    written: Image,
+    durable: Image,
+}
+pub(super) struct Held {
+    pub(super) ready: Ready,
+    pub(super) phase: Phase,
+}
+impl Replica {
+    pub(super) fn write_ready(&mut self, ready: &Ready) {
+        let store = self.core.raft.raft_log.store.clone();
+        let mut cache = store.wl();
+        cache.append(ready.entries()).unwrap();
+        if let Some(first) = ready.entries().first() {
+            let from = usize::try_from(first.index - 1).unwrap();
+            assert!(from <= self.disk.written.entries.len());
+            self.disk.written.entries.truncate(from);
+            self.disk.written.entries.extend_from_slice(ready.entries());
+        }
+        if let Some(hard) = ready.hs() {
+            cache.set_hardstate(hard.clone());
+            self.disk.written.hard = hard.clone();
+        }
+        assert!(self.disk.written.entries.len() <= MAX_ACTIONS * 4);
+    }
+    pub(super) fn sync_image(&mut self) {
+        if !self.bad_sync {
+            self.disk.durable = self.disk.written.clone();
+        }
+    }
+}
+pub(super) fn finish(
+    replica: &mut Replica,
+    mut ready: Ready,
+    messages: &mut VecDeque<ReferenceMessage>,
+) {
+    messages.extend(ready.take_messages());
+    messages.extend(ready.take_persisted_messages());
+    for read in ready.take_read_states() {
+        let request = u64::from_le_bytes(read.request_ctx.as_slice().try_into().unwrap());
+        assert!(replica.reads.insert(request, read.index).is_none());
+    }
+    apply(&mut replica.applied, ready.take_committed_entries());
+    let mut light = replica.core.advance(ready);
+    if let Some(commit) = light.commit_index() {
+        replica
+            .core
+            .raft
+            .raft_log
+            .store
+            .wl()
+            .mut_hard_state()
+            .commit = commit;
+        replica.disk.written.hard.commit = commit;
+        // This host durably stores LightReady commit-only state before an
+        // application result can escape, matching its declared fault contract.
+        replica.sync_image();
+    }
+    messages.extend(light.take_messages());
+    apply(&mut replica.applied, light.take_committed_entries());
+    replica.core.advance_apply();
+}
+impl Reference {
+    pub(in super::super) fn hold(&mut self, id: u64) {
+        self.replicas.get_mut(&id).unwrap().paused = true;
+    }
+    pub(in super::super) fn phase(&self, id: u64) -> Option<Phase> {
+        self.replicas[&id].held.as_ref().map(|held| held.phase)
+    }
+    pub(in super::super) fn write_pending(&mut self, id: u64) -> Result<(), Mismatch> {
+        let replica = self.replicas.get_mut(&id).unwrap();
+        let mut held = replica.held.take().ok_or(Mismatch::Action(id))?;
+        if held.phase != Phase::Accepted {
+            replica.held = Some(held);
+            return Err(Mismatch::Action(id));
+        }
+        replica.write_ready(&held.ready);
+        held.phase = Phase::Written;
+        replica.held = Some(held);
+        Ok(())
+    }
+    pub(in super::super) fn sync(&mut self, id: u64) -> Result<(), Mismatch> {
+        let replica = self.replicas.get_mut(&id).unwrap();
+        let held = replica.held.as_mut().ok_or(Mismatch::Action(id))?;
+        if held.phase != Phase::Written {
+            return Err(Mismatch::Action(id));
+        }
+        held.phase = Phase::Synced;
+        replica.sync_image();
+        Ok(())
+    }
+    pub(in super::super) fn complete(&mut self, id: u64) -> Result<(), Mismatch> {
+        let replica = self.replicas.get_mut(&id).unwrap();
+        let held = replica.held.take().ok_or(Mismatch::Action(id))?;
+        if held.phase != Phase::Synced {
+            replica.held = Some(held);
+            return Err(Mismatch::Action(id));
+        }
+        replica.paused = false;
+        replica.previous = Some((replica.epoch, held.ready.number()));
+        finish(replica, held.ready, &mut self.messages);
+        self.ready(id);
+        Ok(())
+    }
+    pub(in super::super) fn lie_sync(&mut self, id: u64) {
+        self.replicas.get_mut(&id).unwrap().bad_sync = true;
+    }
+    pub(in super::super) fn restart(&mut self, id: u64, power: bool) -> Result<(), Mismatch> {
+        let original = self.commands(id);
+        let old = self.replicas.remove(&id).unwrap();
+        let previous = old
+            .held
+            .as_ref()
+            .map(|held| (old.epoch, held.ready.number()))
+            .or(old.previous);
+        let image = if power {
+            old.disk.durable
+        } else {
+            old.disk.written
+        };
+        let epoch = old.epoch.checked_add(1).unwrap();
+        // No shared MemStorage clone survives restart. Own selected bytes and
+        // HardState build a new provider; the comparison oracle supplies nothing.
+        let store = MemStorage::new_with_conf_state((vec![1, 2, 3], vec![]));
+        {
+            let mut disk = store.wl();
+            disk.append(&image.entries).unwrap();
+            disk.set_hardstate(image.hard.clone());
+        }
+        let logger = slog::Logger::root(slog::Discard, slog::o!());
+        let config = Config {
+            id,
+            max_uncommitted_size: 65536,
+            ..Config::default()
+        };
+        let replica = Replica {
+            core: RawNode::new(&config, store, &logger).unwrap(),
+            applied: Vec::new(),
+            reads: BTreeMap::new(),
+            corrupted_value: false,
+            disk: Disk {
+                written: image.clone(),
+                durable: image,
+            },
+            held: None,
+            paused: false,
+            epoch,
+            previous,
+            bad_sync: false,
+        };
+        self.replicas.insert(id, replica);
+        self.ready(id);
+        let restored = self.commands(id);
+        if !restored.starts_with(&original) {
+            let operation = original
+                .iter()
+                .zip(restored.iter().map(Some).chain(std::iter::repeat(None)))
+                .find(|(old, new)| Some(*old) != *new)
+                .unwrap()
+                .0
+                 .0;
+            return Err(Mismatch::ReferenceRecovery(id, operation));
+        }
+        Ok(())
+    }
+    pub(in super::super) fn stale(&mut self, id: u64) -> Result<(), Mismatch> {
+        let replica = &self.replicas[&id];
+        let (epoch, _) = replica.previous.ok_or(Mismatch::Action(id))?;
+        // The host owns Ready callbacks. RawNode numbers restart from one;
+        // reject the old owner before calling any advancement on the new core.
+        if epoch == replica.epoch {
+            return Err(Mismatch::Action(id));
+        }
+        Ok(())
+    }
+}
diff --git a/tests/raft/reference/native_host.rs b/tests/raft/reference/native_host.rs
new file mode 100644
index 0000000..5a3c4eb
--- /dev/null
+++ b/tests/raft/reference/native_host.rs
@@ -0,0 +1,271 @@
+// SPDX-License-Identifier: RPL-1.5
+// Copyright (c) 2026 Karl Livesey
+use super::*;
+
+enum Held {
+    Accepted(LogUpdate),
+    Written(LogTicket),
+    Synced(DurableLog),
+}
+
+pub(super) struct Native {
+    pub(super) cluster: Cluster<NativeLogStore<ModelIo>>,
+    images: BTreeMap<u64, ModelIo>,
+    paused: BTreeSet<u64>,
+    held: BTreeMap<u64, Held>,
+    previous: BTreeMap<u64, DurableLog>,
+}
+
+impl Native {
+    pub(super) fn new() -> Self {
+        let images: BTreeMap<_, _> = (1..=3).map(|id| (id, ModelIo::default())).collect();
+        let cluster = Cluster::new(bootstrap(1, 3), |id| {
+            NativeLogStore::create(
+                images[&id].clone(),
+                identity(u128::from(id)),
+                LogLimits::default(),
+            )
+            .unwrap()
+        });
+        Self {
+            cluster,
+            images,
+            paused: BTreeSet::new(),
+            held: BTreeMap::new(),
+            previous: BTreeMap::new(),
+        }
+    }
+
+    pub(super) fn act(&mut self, id: u64, event: Event) -> Result<(), Mismatch> {
+        let delivery = matches!(event, Event::Receive(_));
+        let replica = self
+            .cluster
+            .replicas
+            .get_mut(&id)
+            .ok_or(Mismatch::Action(id))?;
+        match replica.core.step(event) {
+            Ok(effects) => self.effects(id, effects),
+            Err(RaftError::Busy) if self.held.contains_key(&id) => Ok(()),
+            Err(RaftError::WrongIdentity) if delivery => Ok(()),
+            Err(_) => Err(Mismatch::Action(id)),
+        }
+    }
+
+    fn effects(&mut self, id: u64, effects: Vec<Effect>) -> Result<(), Mismatch> {
+        let mut pending = VecDeque::from(effects);
+        while let Some(effect) = pending.pop_front() {
+            match effect {
+                Effect::Persist(update) if self.paused.contains(&id) => {
+                    if self.held.contains_key(&id) {
+                        return Err(Mismatch::Action(id));
+                    }
+                    self.held.insert(id, Held::Accepted(update));
+                }
+                Effect::Persist(update) => {
+                    let replica = self
+                        .cluster
+                        .replicas
+                        .get_mut(&id)
+                        .ok_or(Mismatch::Action(id))?;
+                    let more = persist_effect(&mut replica.core, &mut replica.store, update)
+                        .map_err(|_| Mismatch::Action(id))?;
+                    pending.extend(more);
+                }
+                Effect::Send(_) | Effect::Committed(_) | Effect::ReadReady(_) => {
+                    self.cluster.effects(id, vec![effect]);
+                }
+                _ => return Err(Mismatch::Action(id)),
+            }
+        }
+        self.cluster.assert_safety();
+        Ok(())
+    }
+
+    pub(super) fn pump(&mut self) -> Result<(), Mismatch> {
+        let mut count = 0;
+        while let Some(message) = self.cluster.messages.pop_front() {
+            count += 1;
+            if count >= 100_000 {
+                return Err(Mismatch::Action(message.to.get()));
+            }
+            if !self
+                .cluster
+                .blocked
+                .contains(&(message.from.get(), message.to.get()))
+            {
+                self.act(message.to.get(), Event::Receive(message))?;
+            }
+        }
+        Ok(())
+    }
+
+    pub(super) fn phase(&self, id: u64) -> Option<Phase> {
+        self.held.get(&id).map(|held| match held {
+            Held::Accepted(_) => Phase::Accepted,
+            Held::Written(_) => Phase::Written,
+            Held::Synced(_) => Phase::Synced,
+        })
+    }
+
+    pub(super) fn hold(&mut self, id: u64) {
+        self.paused.insert(id);
+    }
+
+    pub(super) fn write_pending(&mut self, id: u64) -> Result<(), Mismatch> {
+        let Some(Held::Accepted(update)) = self.held.get(&id) else {
+            return Err(Mismatch::Action(id));
+        };
+        let update = update.clone();
+        let replica = self
+            .cluster
+            .replicas
+            .get_mut(&id)
+            .ok_or(Mismatch::Action(id))?;
+        let tickets = replica
+            .store
+            .append_batch(vec![LogMutation::Update(update)])
+            .map_err(|_| Mismatch::Action(id))?;
+        let [ticket] = tickets.as_slice() else {
+            return Err(Mismatch::Action(id));
+        };
+        replica
+            .core
+            .admitted(*ticket)
+            .map_err(|_| Mismatch::Action(id))?;
+        self.held.insert(id, Held::Written(*ticket));
+        Ok(())
+    }
+
+    pub(super) fn sync(&mut self, id: u64) -> Result<(), Mismatch> {
+        let Some(Held::Written(ticket)) = self.held.get(&id) else {
+            return Err(Mismatch::Action(id));
+        };
+        let replica = self
+            .cluster
+            .replicas
+            .get_mut(&id)
+            .ok_or(Mismatch::Action(id))?;
+        let completion = replica
+            .store
+            .barrier(&[*ticket])
+            .map_err(|_| Mismatch::Action(id))?;
+        self.held.insert(id, Held::Synced(completion));
+        Ok(())
+    }
+
+    pub(super) fn complete(&mut self, id: u64) -> Result<(), Mismatch> {
+        if !matches!(self.held.get(&id), Some(Held::Synced(_))) {
+            return Err(Mismatch::Action(id));
+        }
+        let Some(Held::Synced(completion)) = self.held.remove(&id) else {
+            return Err(Mismatch::Action(id));
+        };
+        self.paused.remove(&id);
+        let replica = self
+            .cluster
+            .replicas
+            .get_mut(&id)
+            .ok_or(Mismatch::Action(id))?;
+        let effects = replica
+            .core
+            .complete(&completion)
+            .map_err(|_| Mismatch::Action(id))?;
+        self.previous.insert(id, completion);
+        self.effects(id, effects)
+    }
+
+    pub(super) fn restart(&mut self, id: u64, power: bool) -> Result<(), Mismatch> {
+        let acknowledged = self
+            .cluster
+            .applied
+            .get(&id)
+            .ok_or(Mismatch::Action(id))?
+            .clone();
+        let replica = self
+            .cluster
+            .replicas
+            .remove(&id)
+            .ok_or(Mismatch::Action(id))?;
+        let old_session = replica.store.binding().session.get();
+        drop(replica);
+        if let Some(Held::Synced(completion)) = self.held.remove(&id) {
+            self.previous.insert(id, completion);
+        }
+        self.paused.remove(&id);
+        let image = self.images.get(&id).ok_or(Mismatch::Action(id))?;
+        if power {
+            image.0.borrow_mut().power_loss();
+        }
+        let first_operation = acknowledged.iter().find_map(operation).unwrap_or(0);
+        let store = NativeLogStore::recover(
+            image.clone(),
+            identity(u128::from(id)),
+            LogLimits::default(),
+        )
+        .map_err(|_| Mismatch::NativeRecovery(id, first_operation))?;
+        if Some(store.binding().session.get()) != old_session.checked_add(1) {
+            return Err(Mismatch::Action(id));
+        }
+        let state = store.state(group(1)).map_err(|_| Mismatch::Action(id))?;
+        let core = Raft::recover(node(id), store.binding(), state, store.limits())
+            .map_err(|_| Mismatch::NativeRecovery(id, first_operation))?;
+        preserve_commands(id, &acknowledged, core.replay_committed())?;
+        self.cluster
+            .applied
+            .insert(id, core.replay_committed().to_vec());
+        self.cluster.reads.remove(&id);
+        self.cluster.replicas.insert(id, Replica { core, store });
+        self.cluster.assert_safety();
+        Ok(())
+    }
+
+    pub(super) fn stale(&mut self, id: u64) -> Result<(), Mismatch> {
+        let completion = self.previous.get(&id).ok_or(Mismatch::Action(id))?;
+        let replica = self
+            .cluster
+            .replicas
+            .get_mut(&id)
+            .ok_or(Mismatch::Action(id))?;
+        let before = (
+            replica.core.state().clone(),
+            replica.core.role(),
+            replica.core.has_pending_dependency(),
+        );
+        if replica.core.complete(completion) != Err(RaftError::WrongCompletion) {
+            return Err(Mismatch::Action(id));
+        }
+        let after = (
+            replica.core.state().clone(),
+            replica.core.role(),
+            replica.core.has_pending_dependency(),
+        );
+        if before != after {
+            return Err(Mismatch::Action(id));
+        }
+        Ok(())
+    }
+}
+
+fn operation(entry: &LogEntry) -> Option<u128> {
+    match entry.payload {
+        EntryPayload::Command { operation, .. } => Some(operation.get()),
+        _ => None,
+    }
+}
+
+fn preserve_commands(
+    id: u64,
+    acknowledged: &[LogEntry],
+    recovered: &[LogEntry],
+) -> Result<(), Mismatch> {
+    let mut recovered = recovered.iter().filter(|entry| operation(entry).is_some());
+    for original in acknowledged
+        .iter()
+        .filter(|entry| operation(entry).is_some())
+    {
+        if recovered.next() != Some(original) {
+            return Err(Mismatch::NativeRecovery(id, operation(original).unwrap()));
+        }
+    }
+    Ok(())
+}

+    fn every_manifest_publication_boundary_preserves_selected_state_and_lock() {
+        for generation in [0, 1] {
+            for cut in 1..=5 {
+                let path = std::env::temp_dir().join(format!(
+                    "voteboat-publication-cut-{}-{generation}-{cut}",
+                    std::process::id()
+                ));
+                let mut store = NativeLogStore::create(
+                    FileLogIo::create(&path).unwrap(),
+                    identity(),
+                    LogLimits::default(),
+                )
+                .unwrap();
+                let voter = NodeId::new(1).unwrap();
+                let tickets = store
+                    .append_batch(vec![LogMutation::Create(Bootstrap {
+                        group: group(),
+                        configuration: ConfigurationId::new(1).unwrap(),
+                        policy: Policy::new(Tree::Voter(voter), Limits::default()).unwrap(),
+                        voter_stores: [(voter, identity())].into(),
+                    })])
+                    .unwrap();
+                store.barrier(&tickets).unwrap();
+                fill(&mut store);
+                if generation == 1 {
+                    store.reclaim(store.limits().max_wal_bytes).unwrap();
+                }
+                let expected = store.state(group()).unwrap();
+                let old = store.io.read_manifest().unwrap();
+                let binding = StoreBinding {
+                    session: StoreSession::new(store.binding().session.get() + 1).unwrap(),
+                    ..store.binding()
+                };
+                let new = super::super::manifest(binding, store.length as u64);
+                let mut step = 0;
+                assert!(store
+                    .io
+                    .publish_with(&new, || {
+                        step += 1;
+                        if step == cut {
+                            Err(io::Error::other("publication interrupted"))
+                        } else {
+                            Ok(())
+                        }
+                    })
+                    .is_err());
+                assert!(
+                    FileLogIo::open(&path).is_err(),
+                    "failed publication retains exclusive ownership"
+                );
+                drop(store);
+                let mut io = FileLogIo::open(&path).unwrap();
+                let selected = io.read_manifest().unwrap();
+                assert_eq!(
+                    selected,
+                    if cut < 4 { old } else { new },
+                    "atomic name selection at cut{cut}"
+                );
+                let recovered =
+                    NativeLogStore::recover(io, identity(), LogLimits::default()).unwrap();
+                assert_eq!(
+                    recovered.state(group()).unwrap(),
+                    expected,
+                    "acknowledged hard-state history survives cut{cut}"
+                );
+                assert!(recovered.binding().session.get() > binding.session.get() - 1);
+                drop(recovered);
+                fs::remove_dir_all(path).unwrap();
+            }
+        }
+    }

+        std::mem::size_of::<Client>(), std::mem::size_of::<WaitCache>(),
+        std::mem::size_of::<Lease<'_>>(), std::mem::size_of::<Wait>(),
+        std::mem::size_of::<Vec<Wait>>(), std::mem::size_of_val(&future));
+}

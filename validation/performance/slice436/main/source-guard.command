python3 -c import\ hashlib\,json\,stat\;from\ pathlib\ import\ Path\;s=json.loads\(Path\(\"target/p9/slice436/main/SOURCE.json\"\).read_text\(\)\)\;assert\ all\(hashlib.sha256\(Path\(p\).read_bytes\(\)\).hexdigest\(\)==h\ for\ p\,h\ in\ s\[\"sha256\"\].items\(\)\)\;assert\ all\(oct\(stat.S_IMODE\(Path\(p\).stat\(\).st_mode\)\)==v\ for\ p\,v\ in\ s\[\"physical_modes\"\].items\(\)\)\;print\(s\[\"inputs\"\]\,\"exact\ source\ hashes\ and\ physical\ modes\ unchanged\"\) 

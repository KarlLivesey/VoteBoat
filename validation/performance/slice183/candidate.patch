+// HEREBY DISCLAIMS ALL SUCH WARRANTIES, INCLUDING WITHOUT LIMITATION, ANY
+// WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE, QUIET
+// ENJOYMENT, OR NON-INFRINGEMENT. See the RPL for specific language governing
+// rights and limitations under the RPL.
+use super::*;
+
+fn proposed<S: LogStore>(cluster: &mut Cluster<S>) -> LogTicket {
+    let replica = cluster.replicas.get_mut(&1).unwrap();
+    let effects = replica
+        .core
+        .step(Event::Propose {
+            operation: OperationId::new(99).unwrap(),
+            bytes: vec![99],
+        })
+        .unwrap();
+    let [Effect::Persist(update)] = effects.as_slice() else {
+        panic!("expected persistence")
+    };
+    replica
+        .store
+        .append_batch(vec![LogMutation::Update(update.clone())])
+        .unwrap()[0]
+}
+fn leader<S: LogStore>(factory: impl FnMut(u64) -> S) -> Cluster<S> {
+    let mut cluster = Cluster::new(bootstrap(1, 3), factory);
+    cluster.act(1, Event::Campaign);
+    cluster.pump();
+    assert_eq!(cluster.replicas[&1].core.state().commit_index, 1);
+    cluster
+}
+fn messages(effects: Vec<Effect>) -> Vec<Message> {
+    effects
+        .into_iter()
+        .map(|e| match e {
+            Effect::Send(m) => m,
+            _ => panic!("written released a non-send effect"),
+        })
+        .collect()
+}
+#[test]
+fn written_replication_requires_exact_local_durability_before_quorum_progress() {
+    let mut cluster = leader(|id| HostLogStore::new(id.into()));
+    let ticket = proposed(&mut cluster);
+    let before = cluster.replicas[&1].core.state().clone();
+    let mut wrong = ticket;
+    wrong.binding.session = StoreSession::new(99).unwrap();
+    assert_eq!(
+        cluster.replicas.get_mut(&1).unwrap().core.written(wrong),
+        Err(RaftError::WrongCompletion)
+    );
+    let early = messages(
+        cluster
+            .replicas
+            .get_mut(&1)
+            .unwrap()
+            .core
+            .written(ticket)
+            .unwrap(),
+    );
+    assert_eq!(early.len(), 2);
+    assert_eq!(cluster.replicas[&1].core.state(), &before);
+    assert_eq!(
+        cluster.replicas.get_mut(&1).unwrap().core.written(ticket),
+        Err(RaftError::WrongCompletion)
+    );
+    for message in early {
+        assert!(
+            matches!(&message.rpc, Rpc::Append { entries, leader_commit: 1, .. } if entries.len() == 1 && entries[0].index == 2)
+        );
+        cluster.deliver(message);
+    }
+    let replies: Vec<_> = cluster.messages.drain(..).collect();
+    assert_eq!(replies.len(), 2);
+    for reply in &replies {
+        assert_eq!(
+            cluster
+                .replicas
+                .get_mut(&1)
+                .unwrap()
+                .core
+                .step(Event::Receive(reply.clone())),
+            Err(RaftError::Busy)
+        );
+    }
+    assert!(cluster.commands(1).is_empty());
+    assert_eq!(cluster.replicas[&2].core.state().commit_index, 1);
+    let replica = cluster.replicas.get_mut(&1).unwrap();
+    let durable = replica.store.barrier(&[ticket]).unwrap();
+    let after = replica.core.complete(&durable).unwrap();
+    assert!(after.iter().all(|e| matches!(e, Effect::Send(_))));
+    let retry = messages(after);
+    assert_eq!(retry.len(), 2);
+    for message in &retry {
+        assert!(replies
+            .iter()
+            .any(|reply| reply.from == message.to && reply.context == message.context));
+    }
+    for reply in replies {
+        cluster.deliver(reply);
+    }
+    cluster.messages.extend(retry);
+    cluster.pump();
+    for id in 1..=3 {
+        assert_eq!(cluster.commands(id), vec![vec![99]]);
+    }
+}
+
+#[test]
+#[cfg(feature = "native")]
+fn written_leader_power_loss_can_discard_uncommitted_suffix_and_repair() {
+    let devices: Vec<ModelIo> = (0..3).map(|_| ModelIo::default()).collect();
+    let mut cluster = leader(|id| {
+        NativeLogStore::create(
+            devices[id as usize - 1].clone(),
+            identity(id.into()),
+            LogLimits::default(),
+        )
+        .unwrap()
+    });
+    let ticket = proposed(&mut cluster);
+    let early = messages(
+        cluster
+            .replicas
+            .get_mut(&1)
+            .unwrap()
+            .core
+            .written(ticket)
+            .unwrap(),
+    );
+    cluster.deliver(early.into_iter().find(|m| m.to == node(2)).unwrap());
+    assert_eq!(cluster.replicas[&2].core.state().last_index(), 2);
+    cluster.messages.clear();
+    cluster.replicas.get_mut(&1).unwrap().core.storage_failed();
+    devices[0].0.borrow_mut().power_loss();
+    let store =
+        NativeLogStore::recover(devices[0].clone(), identity(1), LogLimits::default()).unwrap();
+    assert_eq!(store.state(group(1)).unwrap().last_index(), 1);
+    let core = Raft::recover(
+        node(1),
+        store.binding(),
+        store.state(group(1)).unwrap(),
+        store.limits(),
+    )
+    .unwrap();
+    cluster.replicas.insert(1, Replica { core, store });
+    cluster.partition(&[2]);
+    cluster.act(3, Event::Campaign);
+    cluster.pump();
+    assert_eq!(cluster.replicas[&3].core.role(), Role::Leader);
+    cluster.propose(3, 100, 100);
+    cluster.heal();
+    cluster.act(3, Event::Heartbeat);
+    cluster.pump();
+    for id in 1..=3 {
+        assert_eq!(cluster.commands(id), vec![vec![100]]);
+    }
+}
+
+#[test]
+#[cfg(feature = "native")]
+fn written_barrier_failures_never_commit_but_a_new_leader_can_preserve_replicated_data() {
+    for fault in [Fault::Sync, Fault::PublishBefore, Fault::PublishAfter] {
+        let devices: Vec<ModelIo> = (0..3).map(|_| ModelIo::default()).collect();
+        let mut cluster = leader(|id| {
+            NativeLogStore::create(
+                devices[id as usize - 1].clone(),
+                identity(id.into()),
+                LogLimits::default(),
+            )
+            .unwrap()
+        });
+        let ticket = proposed(&mut cluster);
+        let early = messages(
+            cluster
+                .replicas
+                .get_mut(&1)
+                .unwrap()
+                .core
+                .written(ticket)
+                .unwrap(),
+        );
+        for message in early {
+            cluster.deliver(message);
+        }
+        cluster.messages.clear();
+        devices[0].0.borrow_mut().fault = fault;
+        let replica = cluster.replicas.get_mut(&1).unwrap();
+        assert!(replica.store.barrier(&[ticket]).is_err());
+        replica.core.storage_failed();
+        assert_eq!(replica.core.state().commit_index, 1);
+        assert!(cluster.commands(1).is_empty());
+        devices[0].0.borrow_mut().power_loss();
+        let store =
+            NativeLogStore::recover(devices[0].clone(), identity(1), LogLimits::default()).unwrap();
+        let core = Raft::recover(
+            node(1),
+            store.binding(),
+            store.state(group(1)).unwrap(),
+            store.limits(),
+        )
+        .unwrap();
+        cluster.replicas.insert(1, Replica { core, store });
+        cluster.act(2, Event::Campaign);
+        cluster.pump();
+        assert_eq!(cluster.replicas[&2].core.role(), Role::Leader);
+        for id in 1..=3 {
+            assert_eq!(cluster.commands(id), vec![vec![99]]);
+        }
+    }
+}
+
+#[test]
+fn written_does_not_replace_an_outstanding_peer_request() {
+    let mut cluster = leader(|id| HostLogStore::new(id.into()));
+    cluster.act(1, Event::Heartbeat);
+    let outstanding: Vec<_> = cluster.messages.drain(..).collect();
+    assert_eq!(outstanding.len(), 2);
+    let ticket = proposed(&mut cluster);
+    assert!(cluster
+        .replicas
+        .get_mut(&1)
+        .unwrap()
+        .core
+        .written(ticket)
+        .unwrap()
+        .is_empty());
+    let replica = cluster.replicas.get_mut(&1).unwrap();
+    let durable = replica.store.barrier(&[ticket]).unwrap();
+    let retry = messages(replica.core.complete(&durable).unwrap());
+    for message in retry {
+        assert!(outstanding
+            .iter()
+            .any(|old| old.to == message.to && old.context == message.context));
+    }
+}

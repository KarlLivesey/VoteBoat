+// HEREBY DISCLAIMS ALL SUCH WARRANTIES, INCLUDING WITHOUT LIMITATION, ANY
+// WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE, QUIET
+// ENJOYMENT, OR NON-INFRINGEMENT. See the RPL for specific language governing
+// rights and limitations under the RPL.
+//! Ordinary leader replication can overlap its local durability barrier.
+use super::*;
+
+impl Raft {
+    /// Admit an exact written ticket and optionally start follower replication.
+    /// Written bytes confer no durable progress, commitment, application or
+    /// read authority. The core remains busy until exact durable completion.
+    /// `admitted` remains available to hosts choosing durable-first scheduling.
+    pub fn written(&mut self, ticket: LogTicket) -> Result<Vec<Effect>, RaftError> {
+        self.admitted(ticket)?;
+        let Some(entries) = self.overlap_entries() else {
+            return Ok(Vec::new());
+        };
+        let start = self.durable.last_index() + 1;
+        let end = entries.last().unwrap().index;
+        let peers: Vec<_> = self
+            .peers()
+            .into_iter()
+            .filter(|peer| {
+                !self.requests.contains_key(peer) && self.next_index.get(peer) == Some(&start)
+            })
+            .collect();
+        self.request_sequence
+            .checked_add(peers.len() as u64)
+            .ok_or(RaftError::Exhausted)?;
+        let mut effects = Vec::with_capacity(peers.len());
+        for peer in peers {
+            let context = self.context()?;
+            self.requests.insert(
+                peer,
+                Replication {
+                    context,
+                    configuration: self.membership.id(),
+                    start,
+                    end,
+                    snapshot: None,
+                },
+            );
+            effects.push(Effect::Send(self.message(
+                peer,
+                context,
+                Rpc::Append {
+                    previous_index: start - 1,
+                    previous_term: self.durable.last_term(),
+                    entries: entries.clone(),
+                    leader_commit: self.durable.commit_index,
+                },
+            )));
+        }
+        Ok(effects)
+    }
+
+    fn overlap_entries(&self) -> Option<Vec<LogEntry>> {
+        let pending = self.pending.as_ref()?;
+        if self.role != Role::Leader
+            || !self.local_voter()
+            || !matches!(pending.after, After::LeaderAppend)
+            || pending.membership != self.membership
+            || self.membership.joint().is_some()
+            || pending.next.hard_state != self.durable.hard_state
+            || pending.next.commit_index != self.durable.commit_index
+            || pending.next.generation != self.durable.generation
+        {
+            return None;
+        }
+        let suffix = pending.update.suffix.as_ref()?;
+        if suffix.from != self.durable.last_index().checked_add(1)?
+            || suffix.entries.is_empty()
+            || suffix.entries.len() > 64
+            || suffix
+                .entries
+                .iter()
+                .any(|entry| matches!(entry.payload, EntryPayload::Configuration(_)))
+        {
+            return None;
+        }
+        let bytes = suffix.entries.iter().try_fold(256usize, |sum, entry| {
+            sum.checked_add(37)?.checked_add(entry.payload_bytes())
+        })?;
+        (bytes <= self.limits.max_batch_bytes).then(|| suffix.entries.clone())
+    }
+}

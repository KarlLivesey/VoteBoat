+// basis, WITHOUT WARRANTY OF ANY KIND, EITHER EXPRESS OR IMPLIED, AND LICENSOR
+// HEREBY DISCLAIMS ALL SUCH WARRANTIES, INCLUDING WITHOUT LIMITATION, ANY
+// WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE, QUIET
+// ENJOYMENT, OR NON-INFRINGEMENT. See the RPL for specific language governing
+// rights and limitations under the RPL.
+use super::*;
+type Peers = Vec<(Owner, HostWorker)>;
+fn peers() -> Peers {
+    let mut peers: Peers = (1..=3)
+        .map(|id| {
+            let mut store = HostLogStore::new(id.into());
+            let runtime = timed(id, &mut store, 1, 3);
+            let worker = HostWorker::new(store);
+            (
+                EffectOwner::new(runtime, worker.binding(), EffectOwnerLimits::default()).unwrap(),
+                worker,
+            )
+        })
+        .collect();
+    peers[0].0.admit(group(1), Event::Campaign).unwrap();
+    drain(&mut peers);
+    assert_eq!(peers[0].0.core(group(1)).unwrap().role(), Role::Leader);
+    peers
+}
+fn drain(peers: &mut Peers) {
+    for _ in 0..1000 {
+        let mut messages = Vec::new();
+        for (owner, worker) in peers.iter_mut() {
+            for event in worker.poll(1) {
+                owner.deliver_worker(event, MonoTime(0)).unwrap();
+            }
+            for step in owner.advance(MonoTime(0), 10).unwrap() {
+                assert!(step.error.is_none());
+            }
+            while let Some(lease) = owner.take_effect().unwrap() {
+                match &lease.effect {
+                    Effect::Persist(_) => {
+                        owner
+                            .submit_persists(worker, vec![lease], MonoTime(0))
+                            .unwrap();
+                    }
+                    Effect::Send(message) => {
+                        messages.push(message.clone());
+                        owner.release(lease, 0, MonoTime(0)).unwrap();
+                    }
+                    Effect::Committed(entries) => {
+                        let through = entries.last().unwrap().index;
+                        owner.release(lease, through, MonoTime(0)).unwrap();
+                    }
+                    _ => panic!("unexpected output"),
+                }
+            }
+        }
+        for message in messages {
+            peers[message.to.get() as usize - 1]
+                .0
+                .admit(group(1), Event::Receive(message))
+                .unwrap();
+        }
+        if peers
+            .iter()
+            .all(|(owner, worker)| owner.is_drained() && worker.is_drained())
+        {
+            return;
+        }
+    }
+    panic!("cluster failed to drain")
+}
+fn begin(owner: &mut Owner, worker: &mut HostWorker) -> WorkerEvent {
+    owner
+        .admit(
+            group(1),
+            Event::Propose {
+                operation: OperationId::new(99).unwrap(),
+                bytes: vec![99],
+            },
+        )
+        .unwrap();
+    owner.advance(MonoTime(0), 1).unwrap();
+    let lease = owner.take_effect().unwrap().unwrap();
+    owner
+        .submit_persists(worker, vec![lease], MonoTime(0))
+        .unwrap();
+    let written = worker.poll(1).pop().unwrap();
+    assert!(matches!(written, WorkerEvent::Written { .. }));
+    written
+}
+#[test]
+fn durable_continuation_preserves_queued_and_held_written_sends() {
+    for hold in [false, true] {
+        let mut peers = peers();
+        let (owner, worker) = &mut peers[0];
+        let written = begin(owner, worker);
+        let reserved = owner.usage().reserved_bytes;
+        owner.deliver_worker(written, MonoTime(0)).unwrap();
+        let lease = hold.then(|| owner.take_effect().unwrap().unwrap());
+        assert_eq!(owner.core(group(1)).unwrap().state().last_index(), 1);
+        let durable = worker.poll(1).pop().unwrap();
+        owner.deliver_worker(durable, MonoTime(0)).unwrap();
+        assert_eq!(owner.usage().reserved_bytes, reserved);
+        assert_eq!(owner.core(group(1)).unwrap().state().commit_index, 1);
+        assert!(!owner.is_drained());
+        if let Some(lease) = lease {
+            assert!(owner.take_effect().unwrap().is_none());
+            let Effect::Send(ref message) = lease.effect else {
+                panic!("expected send")
+            };
+            let mut wrong = EffectLease {
+                ticket: lease.ticket,
+                effect: lease.effect.clone(),
+            };
+            if let Effect::Send(message) = &mut wrong.effect {
+                message.to = node(99);
+            }
+            let rejected = owner.release(wrong, 0, MonoTime(0)).unwrap_err();
+            assert_eq!(rejected.reason, EffectOwnerError::StaleEffect);
+            assert_eq!(owner.usage().reserved_bytes, reserved);
+            let peer = message.to.get() as usize - 1;
+            let event = Event::Receive(message.clone());
+            owner.release(lease, 0, MonoTime(0)).unwrap();
+            peers[peer].0.admit(group(1), event).unwrap();
+        }
+        drain(&mut peers);
+        assert_eq!(peers[0].0.core(group(1)).unwrap().state().commit_index, 2);
+    }
+}
+#[test]
+fn failed_sync_fences_owner_and_retains_only_the_held_send_charge() {
+    let mut peers = peers();
+    let (owner, worker) = &mut peers[0];
+    let written = begin(owner, worker);
+    owner.deliver_worker(written, MonoTime(0)).unwrap();
+    let lease = owner.take_effect().unwrap().unwrap();
+    let reserved = owner.usage().reserved_bytes;
+    worker.fail = true;
+    let failed = worker.poll(1).pop().unwrap();
+    assert!(owner.deliver_worker(failed, MonoTime(0)).is_err());
+    assert!(owner.is_failed());
+    assert_eq!(owner.usage().reserved_bytes, reserved);
+    assert_eq!(owner.core(group(1)).unwrap().state().commit_index, 1);
+    owner.discard_failed(lease).unwrap();
+    assert_eq!(owner.usage().reserved_bytes, 0);
+}

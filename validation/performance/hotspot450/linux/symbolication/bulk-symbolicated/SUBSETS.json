    "suffix_eq": "Suffix PartialEq exact context",
    "persist_helper_context": "persist_effect orpersist_effect_borrowed native/per-RVA inline context, inclusive overlapping",
    "actor_include_admission_context": "Actor::include exact context, pending original admission",
    "actor_requests_context": "Actor::requests exact context, includes proposal effects",
    "actor_deliver_results_context": "Actor::deliver ordeliver_results exact context, pending map removal + original send",

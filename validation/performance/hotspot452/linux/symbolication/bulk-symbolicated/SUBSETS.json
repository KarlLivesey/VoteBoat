    "entry_clone_context": "LogEntry Clone::clone or LogEntry ConvertVec::to_vec exact context",
    "entry_clone_receive_suffix": "take_append_suffix fallback clone frame intersection; not transfer fraction, call/byte count or all receive descendants",
    "entry_clone_pending_plan": "entry clone plus independent OwnedNextLog::plan_copy context, retained intentionally",
    "entry_clone_durable_completion": "entry clone plus Raft::complete committed-effect context",
    "entry_clone_materialize": "entry clone plus LogView::materialize context; may also overlap pending plan",
    "actor_collect_allocation": "collect intersect sampled allocation/deallocation context; not allocation count/cause",
    "byte_vec_clone_context": "Vec<u8> Clone::clone exact per-RVA context; no byte-length inferred from stack",
    "scheduler_native_self": "only native leaf in tokio::runtime::scheduler, not executor ancestor contexts",
    "clone_related": "clone/to_vec function context present; not clone-call count",
    "allocation_deallocation_related": "alloc::alloc/Global allocation, rust allocation shim or malloc/calloc/realloc/free context; not allocation count"

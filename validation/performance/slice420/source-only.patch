+#[tokio::test]
+async fn full_routine_prefix_is_untrusted_owned_and_released_in_fifo_order() {
+    let (sender, mut receiver) = mpsc::channel(128);
+    let mut lookahead = Lookahead::default();
+    let empty_owned = lookahead.owned_bytes();
+    for n in 1..=64 {
+        sender.try_send(reply(n)).unwrap();
+    }
+    assert!(lookahead.inspect(&mut receiver, 1).unwrap());
+    assert_eq!(lookahead.len(), 64);
+    assert!(lookahead.owned_bytes() >= empty_owned);
+    for n in 1..=64 {
+        assert_eq!(
+            lookahead
+                .receive(&mut receiver)
+                .await
+                .unwrap()
+                .context
+                .sequence,
+            n
+        );
+    }
+    assert_eq!(lookahead.active_bytes, 0);
+    assert_eq!(lookahead.owned_bytes(), empty_owned);
+}
+#[test]
+fn protected_head_tail_stale_term_and_uninspected_overflow_veto() {
+    for protected_at in [0, 1, 63] {
+        for rpc in [
+            Rpc::Appended {
+                success: true,
+                matching_index: 1,
+            },
+            Rpc::Voted { granted: true },
+            Rpc::SnapshotAck { index: 1 },
+        ] {
+            let (sender, mut receiver) = mpsc::channel(128);
+            let mut lookahead = Lookahead::default();
+            for n in 0..64 {
+                let mut message = reply(n);
+                if n == protected_at {
+                    message.term = 2;
+                    message.rpc = rpc.clone();
+                }
+                sender.try_send(message).unwrap();
+            }
+            assert!(!lookahead.inspect(&mut receiver, 1).unwrap());
+            assert_eq!(lookahead.len(), protected_at as usize + 1);
+        }
+    }
+    for term in [0, 2] {
+        let (sender, mut receiver) = mpsc::channel(128);
+        let mut message = reply(1);
+        message.term = term;
+        sender.try_send(message).unwrap();
+        assert!(!Lookahead::default().inspect(&mut receiver, 1).unwrap());
+    }
+    let (sender, mut receiver) = mpsc::channel(128);
+    for n in 0..65 {
+        sender.try_send(reply(n)).unwrap();
+    }
+    let mut lookahead = Lookahead::default();
+    assert!(!lookahead.inspect(&mut receiver, 1).unwrap());
+    assert_eq!(lookahead.len(), 64);
+    assert_eq!(receiver.len(), 1);
+}
+#[test]
+fn routine_byte_stop_and_protected_payload_capacity_stay_owned() {
+    let (sender, mut receiver) = mpsc::channel(128);
+    sender.try_send(reply(1)).unwrap();
+    sender.try_send(reply(2)).unwrap();
+    let mut small = Lookahead::new(64, size_of::<Message>());
+    assert!(!small.inspect(&mut receiver, 1).unwrap());
+    assert_eq!(small.len(), 1);
+    assert_eq!(receiver.len(), 1);
+    let (sender, mut receiver) = mpsc::channel(128);
+    let mut message = reply(1);
+    message.rpc = Rpc::Append {
+        previous_index: 1,
+        previous_term: 1,
+        leader_commit: 1,
+        entries: vec![LogEntry {
+            index: 2,
+            term: 1,
+            payload: EntryPayload::Command {
+                operation: OperationId::new(1).unwrap(),
+                bytes: Vec::with_capacity(64 * 1024),
+            },
+        }],
+    };
+    sender.try_send(message).unwrap();
+    let mut lookahead = Lookahead::new(64, 1024);
+    let empty_owned = lookahead.owned_bytes();
+    assert!(!lookahead.inspect(&mut receiver, 1).unwrap());
+    assert!(lookahead.owned_bytes() >= empty_owned + 64 * 1024);
+    lookahead.pop().unwrap();
+    assert_eq!(lookahead.owned_bytes(), empty_owned);
+}
+#[test]
+fn routine_queue_permits_wide_original_batch_without_consuming_ack_evidence() {
+    for trace in [false, true] {
+        if trace {
+            checked_batch::<true>();
+        } else {
+            checked_batch::<false>();
+        }
+    }
+}
+fn checked_batch<const TRACE: bool>() {
+    let (mut actor, sender) = ready_actor::<TRACE>(crate::Envelopes::UpstreamDefault);
+    let (peer, receiver) = mpsc::channel(128);
+    actor.parts.peer_receiver = receiver;
+    peer.try_send(reply(1)).unwrap();
+    let waits = preload(&sender);
+    let first = actor.parts.receiver.try_recv().unwrap();
+    let before = actor.parts.core.state().commit_index;
+    assert!(actor.ready_data_quantum().unwrap());
+    assert_eq!(actor.lookahead.len(), 1);
+    assert_eq!(actor.parts.core.state().commit_index, before);
+    actor.requests(first).unwrap();
+    let diagnostics = serde_json::to_value(actor.parts.stats[0].read()).unwrap();
+    assert_eq!(diagnostics["maximum_proposal_width"], 4096);
+    assert_eq!(diagnostics["proposed_originals"], 4096);
+    for (operation, mut wait) in waits {
+        assert_eq!(wait.try_recv().unwrap(), operation);
+    }
+    assert_eq!(actor.parts.application.applied, 4097);
+    assert!(actor.pending.is_empty());
+}
+#[test]
+fn protected_tail_limits_first_request_and_pending_or_nonleader_vetoes() {
+    let (mut actor, sender) = ready_actor::<false>(crate::Envelopes::UpstreamDefault);
+    let (peer, receiver) = mpsc::channel(128);
+    actor.parts.peer_receiver = receiver;
+    peer.try_send(reply(1)).unwrap();
+    let mut protected = reply(2);
+    protected.rpc = Rpc::Voted { granted: true };
+    peer.try_send(protected).unwrap();
+    let _waits = preload(&sender);
+    let first = actor.parts.receiver.try_recv().unwrap();
+    assert_eq!(actor.collect(first).unwrap().len(), 4);
+    assert_eq!(actor.lookahead.len(), 2);
+    assert_eq!(actor.parts.receiver.len(), 1023);
+    actor.lookahead.pop();
+    actor.lookahead.pop();
+    actor
+        .parts
+        .core
+        .step(Event::Propose {
+            operation: OperationId::new(9999).unwrap(),
+            bytes: Vec::new(),
+        })
+        .unwrap();
+    assert!(!actor.ready_data_quantum().unwrap());
+    let node = NodeId::new(1).unwrap();
+    let binding = actor.parts.store.binding();
+    actor.parts.core = Raft::recover(
+        node,
+        binding,
+        actor.parts.store.state(bootstrap().unwrap().group).unwrap(),
+        LogLimits::default(),
+    )
+    .unwrap();
+    assert_eq!(actor.parts.core.role(), Role::Follower);
+    assert!(!actor.ready_data_quantum().unwrap());
+}

+// SPDX-License-Identifier: RPL-1.5
+// Copyright (c) 2026 Karl Livesey
+//! Inspect owned peer inputs without promoting replies or reordering ingress.
+use super::*;
+
+pub(super) const PEER_LOOKAHEAD_ITEMS: usize = 64;
+const ROUTINE_BYTES: usize = 1024 * 1024;
+const OWNER_BYTES: usize = u32::MAX as usize;
+
+pub(super) struct Lookahead {
+    queue: VecDeque<(Message, usize)>,
+    active_bytes: usize,
+    count_limit: usize,
+    routine_bytes: usize,
+}
+impl Default for Lookahead {
+    fn default() -> Self {
+        Self::new(PEER_LOOKAHEAD_ITEMS, ROUTINE_BYTES)
+    }
+}
+impl Lookahead {
+    fn new(count_limit: usize, routine_bytes: usize) -> Self {
+        Self {
+            queue: VecDeque::with_capacity(count_limit),
+            active_bytes: 0,
+            count_limit,
+            routine_bytes,
+        }
+    }
+    pub fn len(&self) -> usize {
+        self.queue.len()
+    }
+    pub fn owned_bytes(&self) -> usize {
+        size_of::<Self>()
+            + self.queue.capacity() * size_of::<(Message, usize)>()
+            + self.active_bytes
+            - self.len() * size_of::<Message>()
+    }
+    fn routine(message: &Message, term: u64) -> bool {
+        message.term == term && matches!(message.rpc, Rpc::Appended { .. })
+    }
+    pub fn inspect(
+        &mut self,
+        receiver: &mut mpsc::Receiver<Message>,
+        term: u64,
+    ) -> Result<bool, Failure> {
+        while self.queue.len() < self.count_limit && self.active_bytes < self.routine_bytes {
+            let message = match receiver.try_recv() {
+                Ok(message) => message,
+                Err(mpsc::error::TryRecvError::Empty) => break,
+                Err(mpsc::error::TryRecvError::Disconnected) => {
+                    return Err("peer actor input closed".into())
+                }
+            };
+            let cost = voteboat::outbound::message_cost(&message, OWNER_BYTES)
+                .map_err(debug_error)?
+                .1;
+            let active = self
+                .active_bytes
+                .checked_add(cost)
+                .ok_or("peer lookahead bytes overflow")?;
+            let payload = active
+                .checked_sub((self.queue.len() + 1) * size_of::<Message>())
+                .ok_or("peer lookahead accounting")?;
+            let owned = (size_of::<Self>() + self.queue.capacity() * size_of::<(Message, usize)>())
+                .checked_add(payload)
+                .ok_or("peer lookahead ownership overflow")?;
+            if owned > OWNER_BYTES {
+                return Err("peer lookahead actor ownership exceeded".into());
+            }
+            let routine = Self::routine(&message, term);
+            self.queue.push_back((message, cost));
+            self.active_bytes = active;
+            if !routine || active > self.routine_bytes {
+                break;
+            }
+        }
+        Ok(receiver.is_empty()
+            && self.active_bytes <= self.routine_bytes
+            && self
+                .queue
+                .iter()
+                .all(|(message, _)| Self::routine(message, term)))
+    }
+    pub fn timer_courtesy(&self, receiver: &mpsc::Receiver<Message>, term: u64) -> bool {
+        !self.queue.is_empty()
+            && receiver.is_empty()
+            && self.active_bytes <= self.routine_bytes
+            && self
+                .queue
+                .iter()
+                .all(|(message, _)| Self::routine(message, term))
+    }
+    fn pop(&mut self) -> Option<Message> {
+        self.queue.pop_front().map(|(message, cost)| {
+            self.active_bytes -= cost;
+            message
+        })
+    }
+    pub async fn receive(&mut self, receiver: &mut mpsc::Receiver<Message>) -> Option<Message> {
+        if let Some(message) = self.pop() {
+            Some(message)
+        } else {
+            receiver.recv().await
+        }
+    }
+}

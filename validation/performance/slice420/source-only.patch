+// SPDX-License-Identifier: RPL-1.5
+// Copyright (c) 2026 Karl Livesey
+use super::super::tests::ready_actor;
+use super::tests::reply;
+use super::*;
+
+fn request(first: u128, count: usize) -> (Request, Vec<oneshot::Receiver<OperationId>>) {
+    let mut proposals = Vec::new();
+    let mut replies = Vec::new();
+    let mut waits = Vec::new();
+    for value in first..first + count as u128 {
+        let (sender, receiver) = oneshot::channel();
+        proposals.push(Proposal {
+            operation: OperationId::new(value).unwrap(),
+            bytes: Vec::new(),
+        });
+        replies.push(sender);
+        waits.push(receiver);
+    }
+    (Request { proposals, replies }, waits)
+}
+fn persist<const TRACE: bool>(
+    core: &mut Raft,
+    store: &mut MemoryStore<TRACE>,
+    app: &mut Noop,
+    initial: Vec<Effect>,
+) -> Vec<Message> {
+    let mut queue = VecDeque::from(initial);
+    let mut sends = Vec::new();
+    while let Some(effect) = queue.pop_front() {
+        match effect {
+            Effect::Persist(update) => queue.extend(persist_effect(core, store, update).unwrap()),
+            Effect::Committed(entries) => {
+                app.apply_batch(&entries).unwrap();
+            }
+            Effect::Send(message) => sends.push(message),
+            _ => panic!("unexpected election fixture effect"),
+        }
+    }
+    sends
+}
+fn follower_reply(mut request: Message, rpc: Rpc) -> Message {
+    let b = bootstrap().unwrap();
+    request.from = request.to;
+    request.to = NodeId::new(1).unwrap();
+    request.sender = StoreBinding {
+        identity: b.voter_stores[&request.from],
+        session: StoreSession::new(1).unwrap(),
+    };
+    request.rpc = rpc;
+    request
+}
+fn majority_actor<const TRACE: bool>() -> (
+    Actor<TRACE>,
+    mpsc::Sender<Request>,
+    Vec<mpsc::Receiver<Message>>,
+) {
+    let (mut actor, client) = ready_actor::<TRACE>(crate::Envelopes::UpstreamDefault);
+    let b = bootstrap().unwrap();
+    let binding = actor.parts.store.binding();
+    let limits = LogLimits::default();
+    let mut store = MemoryStore::<TRACE>::new(binding, limits, b.clone()).unwrap();
+    let mut core = Raft::recover(
+        NodeId::new(1).unwrap(),
+        binding,
+        store.state(b.group).unwrap(),
+        limits,
+    )
+    .unwrap();
+    core.configure_batch_limits(crate::Envelopes::UpstreamDefault.voteboat_limits())
+        .unwrap();
+    let mut app = Noop {
+        group: b.group,
+        applied: 0,
+    };
+    let effects = core.step(Event::Campaign).unwrap();
+    let vote = persist(&mut core, &mut store, &mut app, effects)
+        .into_iter()
+        .find(|m| m.to == NodeId::new(2).unwrap())
+        .unwrap();
+    let effects = core
+        .step(Event::Receive(follower_reply(
+            vote,
+            Rpc::Voted { granted: true },
+        )))
+        .unwrap();
+    let append = persist(&mut core, &mut store, &mut app, effects)
+        .into_iter()
+        .find(|m| m.to == NodeId::new(2).unwrap() && matches!(m.rpc, Rpc::Append { .. }))
+        .unwrap();
+    let effects = core
+        .step(Event::Receive(follower_reply(
+            append,
+            Rpc::Appended {
+                success: true,
+                matching_index: 1,
+            },
+        )))
+        .unwrap();
+    let final_sent = persist(&mut core, &mut store, &mut app, effects);
+    assert_eq!(core.role(), Role::Leader);
+    assert_eq!(app.applied, 1);
+    actor.parts.core = core;
+    actor.parts.store = store;
+    actor.parts.application = app;
+    actor.parts.settings.clients = 4096;
+    let (senders, receivers): (Vec<_>, Vec<_>) =
+        (0..3).map(|_| mpsc::channel(CHANNEL_CAPACITY)).unzip();
+    actor.parts.peers = senders;
+    for message in final_sent {
+        actor.send(message).unwrap();
+    }
+    (actor, client, receivers)
+}
+fn finish_wave<const TRACE: bool>(
+    actor: &mut Actor<TRACE>,
+    outbound: &mut mpsc::Receiver<Message>,
+    expected: u64,
+) {
+    while actor.parts.application.applied < expected {
+        let message = outbound
+            .try_recv()
+            .expect("controlled follower needs an actual emitted request");
+        let Rpc::Append {
+            previous_index,
+            ref entries,
+            ..
+        } = message.rpc
+        else {
+            panic!("expected ordinary append");
+        };
+        let matching_index = entries.last().map_or(previous_index, |entry| entry.index);
+        actor
+            .step(Event::Receive(follower_reply(
+                message,
+                Rpc::Appended {
+                    success: true,
+                    matching_index,
+                },
+            )))
+            .unwrap();
+    }
+}
+#[tokio::test]
+async fn actual_loop_deferred_overflow_yields_to_staged_protected_and_raw_higher_term() {
+    let (mut actor, client, _outbound) = majority_actor::<false>();
+    let (peer, receiver) = mpsc::channel(128);
+    actor.parts.peer_receiver = receiver;
+    let (_stop, stopped) = watch::channel(false);
+    actor.parts.stopped = stopped;
+    let (first, _first_waits) = request(1, 4094);
+    let (overflow, _overflow_waits) = request(4095, 4);
+    client.try_send(overflow).unwrap();
+    actor.requests(first).unwrap();
+    assert_eq!(actor.deferred.as_ref().unwrap().proposals.len(), 4);
+    assert_eq!(actor.parts.core.state().last_index(), 4095);
+    let mut protected = reply(100);
+    protected.rpc = Rpc::SnapshotAck { index: 1 };
+    peer.try_send(protected).unwrap();
+    assert!(!actor
+        .lookahead
+        .inspect(&mut actor.parts.peer_receiver, 1)
+        .unwrap());
+    let mut higher = reply(101);
+    higher.term = 5;
+    higher.rpc = Rpc::Voted { granted: false };
+    peer.try_send(higher).unwrap();
+    let mut timer = tokio::time::interval(Duration::from_secs(3600));
+    let result = actor.drive(&mut timer).await;
+    assert!(result.is_err());
+    assert_eq!(actor.parts.core.state().hard_state.term, 5);
+    assert_eq!(
+        actor.parts.core.state().last_index(),
+        4095,
+        "deferred Data must not append before the higher term"
+    );
+    assert_eq!(actor.parts.application.applied, 1);
+    assert_eq!(actor.parts.stats[0].actor_turns.load(Ordering::Relaxed), 2);
+    assert_eq!(actor.parts.stats[0].timer_turns.load(Ordering::Relaxed), 0);
+    assert_eq!(actor.lookahead.len(), 0);
+}

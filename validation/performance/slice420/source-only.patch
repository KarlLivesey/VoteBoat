+            origin: StoreBinding {
+                identity: b.voter_stores[&NodeId::new(1).unwrap()],
+                session: StoreSession::new(1).unwrap(),
+            },
+            sequence,
+        },
+        rpc: Rpc::Appended {
+            success: true,
+            matching_index: 1,
+        },
+    }

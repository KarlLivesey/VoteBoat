+#[tokio::test]
+async fn shutdown_drops_staged_peers_and_original_waiters_without_new_data() {
+    let (mut actor, sender) = ready_actor::<false>(crate::Envelopes::UpstreamDefault);
+    let (peer, receiver) = mpsc::channel(128);
+    actor.parts.peer_receiver = receiver;
+    peer.try_send(reply(1)).unwrap();
+    assert!(actor.ready_data_quantum().unwrap());
+    let waits = preload(&sender);
+    actor.parts.stopping.store(true, Ordering::Release);
+    actor.run().await.unwrap();
+    for (_, wait) in waits {
+        assert!(wait.await.is_err());
+    }
+}
+#[test]
+fn canceled_first_waiter_fails_observation_without_withdrawing_committed_commands() {
+    let (mut actor, sender) = ready_actor::<false>(crate::Envelopes::UpstreamDefault);
+    let (peer, receiver) = mpsc::channel(128);
+    actor.parts.peer_receiver = receiver;
+    peer.try_send(reply(1)).unwrap();
+    let mut waits = preload(&sender);
+    let (_, canceled) = waits.remove(0);
+    drop(canceled);
+    let first = actor.parts.receiver.try_recv().unwrap();
+    assert!(actor.requests(first).is_err());
+    assert_eq!(actor.parts.core.state().commit_index, 4097);
+    assert_eq!(actor.parts.application.applied, 4097);
+    for (_, mut wait) in waits {
+        assert!(matches!(
+            wait.try_recv(),
+            Err(oneshot::error::TryRecvError::Empty)
+        ));
+    }
+    drop(actor);
+}

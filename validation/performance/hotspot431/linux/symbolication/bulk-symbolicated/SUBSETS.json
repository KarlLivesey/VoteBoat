    "entry_clone_context": "LogEntry Clone::clone or LogEntry ConvertVec::to_vec exact context",
    "entry_clone_receive_suffix": "new431 take_append_suffix fallback clone frame intersection; not transfer fraction, call/byte count or all receive descendants",

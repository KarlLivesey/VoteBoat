python3 -c import\ hashlib\,json\,stat\;from\ pathlib\ import\ Path\;r=Path\(\"target/p9/slice437/main\"\)\;s=json.loads\(\(r/\"SOURCE.json\"\).read_text\(\)\)\;assert\ all\(hashlib.sha256\(Path\(p\).read_bytes\(\)\).hexdigest\(\)==h\ for\ p\,h\ in\ s\[\"sha256\"\].items\(\)\)\;assert\ all\(oct\(stat.S_IMODE\(Path\(p\).stat\(\).st_mode\)\)==v\ for\ p\,v\ in\ s\[\"physical_modes\"\].items\(\)\)\;assert\ all\(not\ Path\(p\).exists\(\)\ for\ p\ in\ s\[\"deleted\"\]\)\;l=json.loads\(\(r/\"ENGINE_LOADER.json\"\).read_text\(\)\)\;e=Path\(l\[\"path\"\]\).read_bytes\(\)\;suffix=l\[\"appended_loader\"\].encode\(\)\;assert\ e.endswith\(suffix\)\;assert\ hashlib.sha256\(e\[:-len\(suffix\)\]\).hexdigest\(\)==l\[\"baseline_sha256\"\]\;print\(s\[\"inputs\"\]\,\"exact\ source/modes\;\ engineprojection\ byteidentical435\;\ noWaits\ production\ modules\"\) 

+    assert_eq!(restarted.batch_limits(), BatchLimits::default());
+    restarted
+        .configure_batch_limits(aggregate_limits())
+        .unwrap();
+    assert_eq!(restarted.replay_committed().len(), 16385);
+    assert_eq!(
+        restarted.complete(&DurableLog {
+            tickets: vec![exact]
+        }),
+        Err(RaftError::WrongCompletion)
+    );
+}

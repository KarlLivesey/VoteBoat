python3 -c import\ hashlib\,json\,stat\;from\ pathlib\ import\ Path\;r=Path\(\"target/p9/slice438/main\"\)\;s=json.loads\(\(r/\"SOURCE.json\"\).read_text\(\)\)\;assert\ all\(hashlib.sha256\(Path\(p\).read_bytes\(\)\).hexdigest\(\)==h\ for\ p\,h\ in\ s\[\"sha256\"\].items\(\)\)\;assert\ all\(oct\(stat.S_IMODE\(Path\(p\).stat\(\).st_mode\)\)==v\ for\ p\,v\ in\ s\[\"physical_modes\"\].items\(\)\)\;b=json.loads\(\(r/\"SOURCE_BEFORE.json\"\).read_text\(\)\)\;assert\ \[p\ for\ p\ in\ b\[\"sha256\"\]\ if\ b\[\"sha256\"\]\[p\]\!=s\[\"sha256\"\]\[p\]\]==s\[\"changed\"\]\;print\(s\[\"inputs\"\]\,\"exactsourcehash+modes\;1432otherselectedinputs\ unchanged\"\) 

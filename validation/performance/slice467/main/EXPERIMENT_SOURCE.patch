+fn entry(index: u64) -> LogEntry {
+    LogEntry {
+        index,
+        term: index % 7 + 1,
+        payload: if index.is_multiple_of(3) {
+            EntryPayload::Noop
+        } else {
+            EntryPayload::Command {
+                operation: OperationId::new(u128::MAX - u128::from(index)).unwrap(),
+                bytes: vec![index as u8; index as usize % 5].into(),
+            }
+        },
+    }
+}
+fn assert_values(history: &EntryHistory, reference: &[LogEntry]) {
+    assert_eq!(history.len(), reference.len());
+    assert_eq!(history.is_empty(), reference.is_empty());
+    assert_eq!(history.first(), reference.first());
+    assert_eq!(history.last(), reference.last());
+    assert_eq!(history.iter().cloned().collect::<Vec<_>>(), reference);
+    assert_eq!(
+        history.iter().rev().cloned().collect::<Vec<_>>(),
+        reference.iter().rev().cloned().collect::<Vec<_>>()
+    );
+    assert_eq!(history, &EntryHistory::from(reference.to_vec()));
+    assert_eq!(history, &reference.to_vec());
+    for (index, value) in reference.iter().enumerate() {
+        assert_eq!(&history[index], value);
+    }
+    assert!(history.get(reference.len()).is_none());
+    let mut mixed = history.iter();
+    let mut front = 0;
+    let mut back = reference.len();
+    while front < back {
+        assert_eq!(mixed.len(), back - front);
+        assert_eq!(mixed.next(), Some(&reference[front]));
+        front += 1;
+        if front < back {
+            back -= 1;
+            assert_eq!(mixed.next_back(), Some(&reference[back]));
+        }
+    }
+    assert_eq!(mixed.next(), None);
+    assert_eq!(mixed.next_back(), None);
+}

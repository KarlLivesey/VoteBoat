+#[test]
+fn preflight_charges_match_growth_concatenation_trimming_and_capacity_preserving_clone() {
+    let mut history = EntryHistory::default();
+    for index in 0..33 {
+        let batch = EntryBatch::from(vec![entry(index)]);
+        let projected = history.projected_append_allocation_bytes(&batch);
+        let pointer = batch.as_ptr();
+        history.append_batch(batch);
+        assert_eq!(history.allocation_bytes(), projected);
+        assert_eq!(history.last().unwrap() as *const LogEntry, pointer);
+        assert_eq!(history.chunk_count(), index as usize + 1);
+        let clone = history.clone();
+        assert_eq!(clone.chunks.capacity(), history.chunks.capacity());
+        assert_eq!(clone.allocation_bytes(), history.allocation_bytes());
+        let independent = history.chunks.capacity() * size_of::<Chunk>()
+            + history
+                .chunks
+                .iter()
+                .map(|chunk| chunk.batch.allocation_bytes().unwrap())
+                .sum::<usize>();
+        assert_eq!(history.allocation_bytes(), Some(independent));
+    }
+    let tail = EntryHistory::from(vec![entry(101), entry(102)]);
+    let projected = history.projected_concat_allocation_bytes(&tail);
+    history.append_history(tail);
+    assert_eq!(history.allocation_bytes(), projected);
+    for count in 0..=history.len() + 1 {
+        let mut prefix_cut = history.clone();
+        let projected = history.allocation_after_discard_prefix(count);
+        prefix_cut.discard_prefix(count);
+        assert_eq!(prefix_cut.allocation_bytes(), projected);
+        let mut suffix_cut = history.clone();
+        let projected = history.allocation_after_truncate(count);
+        suffix_cut.truncate(count);
+        assert_eq!(suffix_cut.allocation_bytes(), projected);
+    }
+    // Simulate an earlier checked-sum overflow: removing its owners must permit
+    // recovery of a representable summary rather than permanently poisoning it.
+    let mut overflowed = history.clone();
+    overflowed.batch_bytes = None;
+    assert_eq!(overflowed.allocation_bytes(), None);
+    let projected = overflowed.allocation_after_discard_prefix(1);
+    overflowed.discard_prefix(1);
+    assert_eq!(overflowed.allocation_bytes(), projected);
+    assert!(overflowed.allocation_bytes().is_some());
+}

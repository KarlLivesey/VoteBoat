+#[test]
+fn every_subrange_and_mixed_direction_iterator_matches_vec() {
+    let reference = (0..19).map(entry).collect::<Vec<_>>();
+    let mut history = EntryHistory::default();
+    for part in reference.chunks(4) {
+        history.append_batch(part.to_vec().into());
+    }
+    for start in 0..=reference.len() {
+        for end in start..=reference.len() {
+            let range = history.range(start..end).unwrap();
+            assert_eq!(range.len(), end - start);
+            assert_eq!(range.is_empty(), start == end);
+            assert_eq!(range.to_vec(), reference[start..end]);
+            assert_eq!(range.to_cow().as_ref(), &reference[start..end]);
+            assert_eq!(
+                range.into_iter().rev().cloned().collect::<Vec<_>>(),
+                reference[start..end]
+                    .iter()
+                    .rev()
+                    .cloned()
+                    .collect::<Vec<_>>()
+            );
+            let mut iterator = range.iter();
+            let mut expected = reference[start..end].iter();
+            while !expected.as_slice().is_empty() {
+                assert_eq!(iterator.next(), expected.next());
+                assert_eq!(iterator.next_back(), expected.next_back());
+                assert_eq!(iterator.len(), expected.len());
+            }
+            assert!(iterator.next().is_none());
+        }
+    }
+    assert!(history.range(20..).is_none());
+    assert!(history
+        .range((Bound::Excluded(usize::MAX), Bound::Unbounded))
+        .is_none());
+    assert!(history.range(..=usize::MAX).is_none());
+    assert!(history
+        .range((Bound::Included(7), Bound::Excluded(3)))
+        .is_none());
+    assert_eq!(history.view(..=3).as_contiguous(), Some(&reference[..4]));
+    assert!(matches!(history.view(3..5).to_cow(), Cow::Owned(_)));
+    assert!(matches!(history.view(4..8).to_cow(), Cow::Borrowed(_)));

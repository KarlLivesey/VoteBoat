+#[test]
+fn chunked_edits_and_lookups_match_independent_vec_history() {
+    let mut history = EntryHistory::default();
+    let mut reference = Vec::new();
+    for round in 0..97u64 {
+        match round % 7 {
+            0 | 1 => {
+                let values = (0..round % 5 + 1)
+                    .map(|offset| entry(round * 17 + offset))
+                    .collect::<Vec<_>>();
+                history.append_batch(values.clone().into());
+                reference.extend(values);
+            }
+            2 => {
+                let values = [entry(round * 17), entry(round * 17 + 1)];
+                let mut tail = EntryHistory::from(vec![values[0].clone()]);
+                tail.push(values[1].clone());
+                history.append_history(tail);
+                reference.extend(values);
+            }
+            3 => {
+                let count = reference.len() / 3;
+                history.discard_prefix(count);
+                reference.drain(..count);
+            }
+            4 => {
+                let keep = reference.len().saturating_sub(2);
+                history.truncate(keep);
+                reference.truncate(keep);
+            }
+            5 if !reference.is_empty() => {
+                let index = reference.len() / 2;
+                let replacement = entry(round * 37);
+                assert_eq!(
+                    history.replace(index, replacement.clone()),
+                    Some(reference[index].clone())
+                );
+                reference[index] = replacement;
+            }
+            _ => {
+                history.extend([entry(round * 17)]);
+                reference.push(entry(round * 17));
+            }
+        }
+        assert_values(&history, &reference);
+    }
+    assert_eq!(history.replace(reference.len(), entry(1)), None);
+    history.truncate(usize::MAX);
+    assert_values(&history, &reference);
+    history.discard_prefix(usize::MAX);
+    assert_values(&history, &[]);
+    history.extend_from_slice(&reference);
+    assert_values(&history, &reference);
+    history.clear();
+    assert_values(&history, &[]);
+}

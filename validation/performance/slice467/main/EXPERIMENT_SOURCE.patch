+    let batches =
+        [0, 100, 200].map(|start| (start..start + 100).map(entry).collect::<EntryBatch>());
+    let mut history = EntryHistory::default();
+    let mut reference = Vec::new();
+    let mut full_backings = 0usize;
+    for (position, batch) in batches.iter().enumerate() {
+        history.append_batch(batch.clone());
+        reference.extend(batch.iter().cloned());
+        history.truncate(position + 1);
+        reference.truncate(position + 1);
+        full_backings += batch.allocation_bytes().unwrap();
+        assert_values(&history, &reference);
+        assert_eq!(history.chunk_count(), position + 1);
+        assert_eq!(
+            history.capacity(),
+            batches[..=position].iter().map(EntryBatch::capacity).sum()
+        );
+        assert_eq!(
+            history.allocation_bytes(),
+            Some(full_backings + history.chunks.capacity() * size_of::<Chunk>())
+        );
+        for (index, retained) in batches[..=position].iter().enumerate() {
+            assert!(std::ptr::eq(history.get(index).unwrap(), &retained[0]));
+        }
+    }
+    assert_eq!(reference, vec![entry(0), entry(100), entry(200)]);
+    let independent = history.clone();
+    assert_eq!(independent.allocation_bytes(), history.allocation_bytes());
+    let old = history.replace(1, entry(999)).unwrap();
+    assert_eq!(old, entry(100));
+    assert_values(&independent, &reference);
+    assert_eq!(history[1], entry(999));
+    assert_eq!(batches[1][0], entry(100));
+    history.truncate(1);
+    assert_values(&history, &[entry(0)]);
+    assert_eq!(
+        history.allocation_bytes(),
+        Some(
+            batches[0].allocation_bytes().unwrap() + history.chunks.capacity() * size_of::<Chunk>()
+        )
+    );
+    assert_values(&independent, &reference);
+}

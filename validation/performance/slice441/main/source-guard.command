python3 -c import\ hashlib\,json\,stat\;from\ pathlib\ import\ Path\;r=Path\(\"target/p9/slice441/main\"\)\;s=json.loads\(\(r/\"SOURCE.json\"\).read_text\(\)\)\;b=json.loads\(\(r/\"SOURCE_BEFORE.json\"\).read_text\(\)\)\;assert\ all\(hashlib.sha256\(Path\(p\).read_bytes\(\)\).hexdigest\(\)==h\ for\ p\,h\ in\ s\[\"sha256\"\].items\(\)\)\;assert\ all\(oct\(stat.S_IMODE\(Path\(p\).stat\(\).st_mode\)\)==v\ for\ p\,v\ in\ s\[\"physical_modes\"\].items\(\)\)\;assert\ \[p\ for\ p\ in\ s\[\"sha256\"\]\ if\ b\[\"sha256\"\]\[p\]\!=s\[\"sha256\"\]\[p\]\]==s\[\"changed\"\]\;assert\ set\(b\[\"sha256\"\]\)-set\(s\[\"sha256\"\]\)==set\(s\[\"deleted\"\]\)\;assert\ all\(not\ Path\(p\).exists\(\)\ for\ p\ in\ s\[\"deleted\"\]\)\;baseline=json.loads\(Path\(\"validation/performance/slice439/main/SOURCE.json\"\).read_text\(\)\)\;assert\ s\[\"sha256\"\]==baseline\[\"sha256\"\]\ and\ s\[\"physical_modes\"\]==baseline\[\"physical_modes\"\]\;print\(s\[\"inputs\"\]\,\"sourcehashes/modes\ exact439\;\ Actor\ exact435/diag439\;1432otherinputs\ unchanged440\;2deletedmodules\ absent\"\) 

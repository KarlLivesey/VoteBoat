{
  "version": 1,
  "status": "shared-runtime-with-bounded-asynchronous-wal-worker",
  "selection": "construction-time",
  "third_party_runtime_dependencies": [],
  "contracts": [
    {
      "design_id": "C01/C02",
      "public_contract": "VoteStore",
      "operations": [
        "binding",
        "recovered",
        "append_votes",
        "barrier"
      ],
      "native": "NativeVoteStore",
      "conformance": [
        "tests/vote.rs",
        "tests/native_vote_store.rs"
      ],
      "scope": "Ballot-only provider. Full-log deployments select LogStore instead; no duplicate log stack."
    },
    {
      "design_id": "C04",
      "public_contract": "VoteIo",
      "operations": [
        "read_manifest",
        "read_log",
        "append",
        "sync_log",
        "truncate_log",
        "publish_manifest"
      ],
      "native": "FileVoteIo",
      "conformance": [
        "tests/native_vote_store.rs"
      ],
      "scope": "Synchronous bounded worker interface; no async runtime yet."
    },
    {
      "design_id": "C08",
      "public_contract": "VoteLogCodec",
      "operations": [
        "format_version",
        "encode",
        "frame_length",
        "decode"
      ],
      "native": "NativeVoteCodec",
      "conformance": [
        "tests/native_vote_store.rs"
      ],
      "scope": "Version-1 vote framing. Different physical formats require migration."
    },
    {
      "design_id": "C01/C02",
      "public_contract": "LogStore",
      "operations": [
        "binding",
        "limits",
        "state",
        "append_batch",
        "barrier",
        "fetch_range"
      ],
      "native": "NativeLogStore",
      "conformance": [
        "tests/log_store.rs",
        "tests/raft.rs"
      ],
      "scope": "Static bootstrap, atomic entries/hard-state/commit, suffix fencing and durably pinned snapshot bases. Physical WAL reclamation remains pending."
    },
    {
      "design_id": "C04",
      "public_contract": "JournalIo",
      "operations": [
        "read_manifest",
        "read_log",
        "append",
        "sync_log",
        "truncate_log",
        "publish_manifest"
      ],
      "native": "FileLogIo",
      "conformance": [
        "tests/log_store.rs",
        "tests/raft.rs"
      ],
      "scope": "Same platform contract as VoteIo, with separate selected native storage binding."
    },
    {
      "design_id": "C08",
      "public_contract": "LogCodec",
      "operations": [
        "format_version",
        "encode_batch",
        "frame_length",
        "decode_batch"
      ],
      "native": "NativeLogCodec",
      "conformance": [
        "tests/log_store.rs"
      ],
      "scope": "Bounded version-2 entry/bootstrap/transition framing."
    },
    {
      "design_id": "C05",
      "public_contract": "StateMachine",
      "operations": [
        "applied_index",
        "apply_batch"
      ],
      "native": "Counter",
      "conformance": [
        "tests/application.rs",
        "examples/replicated_counter.rs"
      ],
      "scope": "Deterministic bounded counter and exact operation retries; checkpoint capability is an explicit extension."
    },
    {
      "design_id": "C05",
      "public_contract": "ReadableStateMachine",
      "operations": [
        "read_at"
      ],
      "native": "Counter",
      "conformance": [
        "tests/raft.rs",
        "examples/replicated_counter.rs"
      ],
      "scope": "Immutable read after exact one-use quorum barrier and applied-prefix check. Host query/result types are supported; no clock leases."
    },
    {
      "design_id": "C03",
      "public_contract": "SnapshotStore",
      "operations": [
        "identity",
        "binding",
        "limits",
        "begin",
        "write_chunk",
        "seal",
        "publish",
        "abort",
        "load"
      ],
      "native": "NativeSnapshotStore",
      "conformance": [
        "tests/snapshot.rs",
        "examples/replicated_counter.rs"
      ],
      "scope": "One local group per logical handle, bounded stage/seal and atomic publication. Shared drivers compose peer installation with authoritative log persistence and application restore."
    },
    {
      "design_id": "C03",
      "public_contract": "SnapshotRetention",
      "operations": ["latest_reference", "pin_for_log", "load_pinned", "reconcile_log"],
      "native": "NativeSnapshotStore",
      "conformance": ["tests/snapshot.rs", "examples/replicated_counter.rs"],
      "scope": "Durable local log anchors and atomic two-slot pin switches. Logical compaction and verified recovery; physical WAL cleaning and general backup retention remain pending."
    },
    {
      "design_id": "C04",
      "public_contract": "SnapshotIo",
      "operations": [
        "read_manifest",
        "read_slot",
        "begin_slot",
        "append_slot",
        "sync_slot",
        "publish_manifest"
      ],
      "native": "FileSnapshotIo",
      "conformance": [
        "tests/snapshot.rs"
      ],
      "scope": "Exclusive two-slot I/O; data and file-name sync precede root publication."
    },
    {
      "design_id": "C08",
      "public_contract": "SnapshotCodec",
      "operations": [
        "format_version",
        "prefix",
        "finish",
        "decode"
      ],
      "native": "NativeSnapshotCodec",
      "conformance": [
        "tests/snapshot.rs"
      ],
      "scope": "Version-1 CRC32C framing with bounded bootstrap/application data. No cryptographic provenance claim."
    },
    {
      "design_id": "C05",
      "public_contract": "CheckpointStateMachine",
      "operations": [
        "schema_version",
        "checkpoint",
        "restore_checkpoint"
      ],
      "native": "Counter",
      "conformance": [
        "tests/application.rs",
        "tests/snapshot.rs",
        "examples/replicated_counter.rs"
      ],
      "scope": "Complete value/boundary/dedup state with exact capacity/schema validation. Host schema and state are composable."
    },
    {
      "design_id": "C10",
      "public_contract": "ReadyScheduler",
      "operations": ["capacity", "enqueue", "pop", "cancel", "len"],
      "native": "FairScheduler",
      "conformance": ["tests/runtime.rs"],
      "scope": "Unique bounded readiness with fair requeue; Shard owns cores and enforces item/byte/time visits, ingress credits and scoped single-owner access. Caller-driven, no hidden threads."
    },
    {
      "design_id": "C11",
      "public_contract": "TimerService",
      "operations": ["owner", "capacity", "register", "cancel", "poll", "len"],
      "native": "DeadlineQueue",
      "conformance": ["tests/runtime.rs"],
      "scope": "Bounded ordered deadlines with exact scoped tokens, replacement/cancellation and lateness. TimedShard supplies automatic consensus timer management through this public seam."
    },
    {
      "design_id": "C10/C11",
      "public_contract": "TimedShard",
      "operations": ["register", "admit", "poll_timers", "poll", "step_next", "with_core", "finish", "stop_group", "close_admission"],
      "native": "TimedShard<FairScheduler, DeadlineQueue, JitterEntropy>",
      "conformance": ["tests/runtime.rs"],
      "scope": "Single-owner automatic election/heartbeat deadlines, exact queued expiration fencing, bounded overload retry and explicit provider failure. Caller supplies monotonic time and bounded effect workers. No deadline-derived read authority."
    },
    {
      "design_id": "C12",
      "public_contract": "Clock",
      "operations": ["now"],
      "native": "MonotonicClock",
      "conformance": ["tests/runtime.rs"],
      "scope": "Local monotonic milliseconds with clone-shared epoch; virtual host clock injection. No core clock reads or diagnostic wall-clock API."
    },
    {
      "design_id": "C04/C10",
      "public_contract": "PersistenceWorker",
      "operations": ["binding", "limits", "usage", "submit", "poll", "close", "is_drained"],
      "native": "NativeLogWorker<L: LogStore + Send>",
      "conformance": ["tests/worker.rs"],
      "scope": "Explicit owned batches, separate written/durable stages, one pending transition per group, bounded request/unit/capacity-byte retention with control reserves and terminal-delivery credit release. The selected store remains authoritative; cores stay on their owner. Native close drains accepted work and try_reclaim returns the store. Three-node/100-group integration covers replication, read barriers, retries, leader replacement and actual-file restart."
    },
    {
      "design_id": "C10",
      "public_contract": "WorkerWake",
      "operations": ["wake"],
      "native": "ThreadWake",
      "conformance": ["tests/worker.rs"],
      "scope": "Injected nonblocking completion hint, never durable evidence. Shared host resources remain host-owned."
    },
    {
      "design_id": "C13",
      "public_contract": "ElectionEntropy",
      "operations": ["sample"],
      "native": "JitterEntropy",
      "conformance": ["tests/runtime.rs"],
      "scope": "Explicitly seeded reproducible election jitter; independent node seeds supplied by host. No cryptographic/identity use."
    }
  ],
  "not_yet_implemented": [
    "physical-wal-reclamation",
    "transport",
    "wire-codec",
    "secure-session",
    "asynchronous-snapshot-worker-assembly",
    "outbound-admission",
    "buffers",
    "admission-policy",
    "routing",
    "discovery",
    "placement",
    "observability",
    "configuration-admin",
    "authorization",
    "compression",
    "scope-transfer",
    "transactions"
  ]
}

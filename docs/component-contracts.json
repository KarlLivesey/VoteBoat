  "not_yet_implemented": ["snapshots", "replication-log", "application", "transport", "wire-codec", "secure-session", "scheduler", "timers", "clock", "entropy", "buffers", "admission-policy", "routing", "discovery", "placement", "observability", "configuration-admin", "authorization", "compression", "scope-transfer", "transactions"]

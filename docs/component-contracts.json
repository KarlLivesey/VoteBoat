{
  "version": 1,
  "status": "static-configuration-replication-slice",
  "selection": "construction-time",
  "third_party_runtime_dependencies": [],
  "contracts": [
    {
      "design_id": "C01/C02",
      "public_contract": "VoteStore",
      "operations": [
        "binding",
        "recovered",
        "append_votes",
        "barrier"
      ],
      "native": "NativeVoteStore",
      "conformance": [
        "tests/vote.rs",
        "tests/native_vote_store.rs"
      ],
      "scope": "Durable ballots only. Full LogStore, snapshots and entries pending."
    },
    {
      "design_id": "C04",
      "public_contract": "VoteIo",
      "operations": [
        "read_manifest",
        "read_log",
        "append",
        "sync_log",
        "truncate_log",
        "publish_manifest"
      ],
      "native": "FileVoteIo",
      "conformance": [
        "tests/native_vote_store.rs"
      ],
      "scope": "Synchronous bounded worker interface; no async runtime yet."
    },
    {
      "design_id": "C08",
      "public_contract": "VoteLogCodec",
      "operations": [
        "format_version",
        "encode",
        "frame_length",
        "decode"
      ],
      "native": "NativeVoteCodec",
      "conformance": [
        "tests/native_vote_store.rs"
      ],
      "scope": "Version-1 vote framing. Different physical formats require migration."
    },
    {
      "design_id": "C01/C02",
      "public_contract": "LogStore",
      "operations": [
        "binding",
        "limits",
        "state",
        "append_batch",
        "barrier",
        "fetch_range"
      ],
      "native": "NativeLogStore",
      "conformance": [
        "tests/log_store.rs",
        "tests/raft.rs"
      ],
      "scope": "Static bootstrap, atomic entries/hard-state/commit, suffix fencing. Snapshots and retention pending."
    },
    {
      "design_id": "C04",
      "public_contract": "JournalIo",
      "operations": [
        "read_manifest",
        "read_log",
        "append",
        "sync_log",
        "truncate_log",
        "publish_manifest"
      ],
      "native": "FileLogIo",
      "conformance": [
        "tests/log_store.rs",
        "tests/raft.rs"
      ],
      "scope": "Same platform contract as VoteIo, with separate selected native storage binding."
    },
    {
      "design_id": "C08",
      "public_contract": "LogCodec",
      "operations": [
        "format_version",
        "encode_batch",
        "frame_length",
        "decode_batch"
      ],
      "native": "NativeLogCodec",
      "conformance": [
        "tests/log_store.rs"
      ],
      "scope": "Bounded version-2 entry/bootstrap/transition framing."
    },
    {
      "design_id": "C05",
      "public_contract": "StateMachine",
      "operations": [
        "applied_index",
        "apply_batch"
      ],
      "native": "Counter",
      "conformance": [
        "tests/application.rs",
        "examples/replicated_counter.rs"
      ],
      "scope": "Deterministic bounded counter and exact operation retries. Checkpoints pending."
    }
  ],
  "not_yet_implemented": [
    "snapshots",
    "transport",
    "wire-codec",
    "secure-session",
    "scheduler",
    "timers",
    "clock",
    "entropy",
    "buffers",
    "admission-policy",
    "routing",
    "discovery",
    "placement",
    "observability",
    "configuration-admin",
    "authorization",
    "compression",
    "scope-transfer",
    "transactions"
  ]
}

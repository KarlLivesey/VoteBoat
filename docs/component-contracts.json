{
  "version": 1,
  "status": "static-replication-reads-and-local-checkpoints",
  "selection": "construction-time",
  "third_party_runtime_dependencies": [],
  "contracts": [
    {
      "design_id": "C01/C02",
      "public_contract": "VoteStore",
      "operations": [
        "binding",
        "recovered",
        "append_votes",
        "barrier"
      ],
      "native": "NativeVoteStore",
      "conformance": [
        "tests/vote.rs",
        "tests/native_vote_store.rs"
      ],
      "scope": "Ballot-only provider. Full-log deployments select LogStore instead; no duplicate log stack."
    },
    {
      "design_id": "C04",
      "public_contract": "VoteIo",
      "operations": [
        "read_manifest",
        "read_log",
        "append",
        "sync_log",
        "truncate_log",
        "publish_manifest"
      ],
      "native": "FileVoteIo",
      "conformance": [
        "tests/native_vote_store.rs"
      ],
      "scope": "Synchronous bounded worker interface; no async runtime yet."
    },
    {
      "design_id": "C08",
      "public_contract": "VoteLogCodec",
      "operations": [
        "format_version",
        "encode",
        "frame_length",
        "decode"
      ],
      "native": "NativeVoteCodec",
      "conformance": [
        "tests/native_vote_store.rs"
      ],
      "scope": "Version-1 vote framing. Different physical formats require migration."
    },
    {
      "design_id": "C01/C02",
      "public_contract": "LogStore",
      "operations": [
        "binding",
        "limits",
        "state",
        "append_batch",
        "barrier",
        "fetch_range"
      ],
      "native": "NativeLogStore",
      "conformance": [
        "tests/log_store.rs",
        "tests/raft.rs"
      ],
      "scope": "Static bootstrap, atomic entries/hard-state/commit, suffix fencing. Snapshots and retention pending."
    },
    {
      "design_id": "C04",
      "public_contract": "JournalIo",
      "operations": [
        "read_manifest",
        "read_log",
        "append",
        "sync_log",
        "truncate_log",
        "publish_manifest"
      ],
      "native": "FileLogIo",
      "conformance": [
        "tests/log_store.rs",
        "tests/raft.rs"
      ],
      "scope": "Same platform contract as VoteIo, with separate selected native storage binding."
    },
    {
      "design_id": "C08",
      "public_contract": "LogCodec",
      "operations": [
        "format_version",
        "encode_batch",
        "frame_length",
        "decode_batch"
      ],
      "native": "NativeLogCodec",
      "conformance": [
        "tests/log_store.rs"
      ],
      "scope": "Bounded version-2 entry/bootstrap/transition framing."
    },
    {
      "design_id": "C05",
      "public_contract": "StateMachine",
      "operations": [
        "applied_index",
        "apply_batch"
      ],
      "native": "Counter",
      "conformance": [
        "tests/application.rs",
        "examples/replicated_counter.rs"
      ],
      "scope": "Deterministic bounded counter and exact operation retries; checkpoint capability is an explicit extension."
    },
    {
      "design_id": "C05",
      "public_contract": "ReadableStateMachine",
      "operations": [
        "read_at"
      ],
      "native": "Counter",
      "conformance": [
        "tests/raft.rs",
        "examples/replicated_counter.rs"
      ],
      "scope": "Immutable read after exact one-use quorum barrier and applied-prefix check. Host query/result types are supported; no clock leases."
    },
    {
      "design_id": "C03",
      "public_contract": "SnapshotStore",
      "operations": [
        "identity",
        "binding",
        "limits",
        "begin",
        "write_chunk",
        "seal",
        "publish",
        "abort",
        "load"
      ],
      "native": "NativeSnapshotStore",
      "conformance": [
        "tests/snapshot.rs",
        "examples/replicated_counter.rs"
      ],
      "scope": "One local group per logical handle, bounded stage/seal and atomic publication. No peer installation, permanent pins or log deletion yet."
    },
    {
      "design_id": "C04",
      "public_contract": "SnapshotIo",
      "operations": [
        "read_manifest",
        "read_slot",
        "begin_slot",
        "append_slot",
        "sync_slot",
        "publish_manifest"
      ],
      "native": "FileSnapshotIo",
      "conformance": [
        "tests/snapshot.rs"
      ],
      "scope": "Exclusive two-slot I/O; data and file-name sync precede root publication."
    },
    {
      "design_id": "C08",
      "public_contract": "SnapshotCodec",
      "operations": [
        "format_version",
        "prefix",
        "finish",
        "decode"
      ],
      "native": "NativeSnapshotCodec",
      "conformance": [
        "tests/snapshot.rs"
      ],
      "scope": "Version-1 CRC32C framing with bounded bootstrap/application data. No cryptographic provenance claim."
    },
    {
      "design_id": "C05",
      "public_contract": "CheckpointStateMachine",
      "operations": [
        "schema_version",
        "checkpoint",
        "restore_checkpoint"
      ],
      "native": "Counter",
      "conformance": [
        "tests/application.rs",
        "tests/snapshot.rs",
        "examples/replicated_counter.rs"
      ],
      "scope": "Complete value/boundary/dedup state with exact capacity/schema validation. Host schema and state are composable."
    }
  ],
  "not_yet_implemented": [
    "peer-snapshot-installation",
    "snapshot-pins-and-log-reclamation",
    "transport",
    "wire-codec",
    "secure-session",
    "scheduler",
    "timers",
    "clock",
    "entropy",
    "buffers",
    "admission-policy",
    "routing",
    "discovery",
    "placement",
    "observability",
    "configuration-admin",
    "authorization",
    "compression",
    "scope-transfer",
    "transactions"
  ]
}
